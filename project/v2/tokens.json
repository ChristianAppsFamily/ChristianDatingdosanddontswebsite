{
  "$name": "Christian Dating Do's & Don'ts — Brand tokens v2",
  "$concept": "Modern Romance. Rooted in Faith.",
  "$note": "Platform-independent mirror of v2/tokens.css. Values in px unless noted. iOS: map px → pt 1:1.",
  "color": {
    "primitive": {
      "coral": { "50": "#FEF3F0", "100": "#FCE3DD", "300": "#F4A193", "500": "#EA624F", "600": "#DD5240", "700": "#B23F2C", "900": "#6E2418" },
      "ink": { "200": "#D9D2DA", "300": "#B4ABB7", "500": "#6B6171", "700": "#4A4150", "800": "#352C3B", "900": "#261F2B" },
      "warm": { "0": "#FFFFFF", "50": "#FFFBF7", "100": "#FAF3EC", "200": "#F2E8DE", "300": "#E6D9CC" },
      "gold": { "100": "#FBEED6", "300": "#F5D6A0", "700": "#7A5410" },
      "sage": { "100": "#EDF3EE", "300": "#DCE7DE", "700": "#3D6148" },
      "plum": { "100": "#F1EBF4", "300": "#E2D5E8", "700": "#6A4778" }
    },
    "role": {
      "bg": "warm.50", "bgMuted": "warm.100", "surface": "warm.0", "surfaceSunk": "warm.100",
      "bgInverse": "ink.900", "surfaceInverse": "ink.800",
      "text": "ink.900", "text2": "ink.700", "text3": "ink.500", "textDisabled": "ink.300",
      "textOnInverse": "warm.50", "textOnInverse2": "#CFC5D3",
      "textAccent": "coral.700", "textOnAccent": "ink.900",
      "accent": "coral.500", "accentHover": "coral.600", "accentSoft": "coral.100",
      "line": "warm.200", "lineStrong": "warm.300", "lineInverse": "rgba(255,251,247,0.14)",
      "focus": "ink.900", "focusInverse": "gold.300",
      "success": "#2F6B47", "successSoft": "sage.100", "error": "#A8332A", "errorSoft": "#FBE4E1"
    },
    "stage": {
      "seeking":  { "fg": "coral.700", "bg": "coral.100", "dot": "coral.500", "icon": "compass" },
      "dating":   { "fg": "plum.700",  "bg": "plum.100",  "dot": "#8C6A9B",   "icon": "messages-square" },
      "engaged":  { "fg": "gold.700",  "bg": "gold.100",  "dot": "#C99A45",   "icon": "calendar-check" },
      "starting": { "fg": "sage.700",  "bg": "sage.100",  "dot": "#6F9A7B",   "icon": "sunrise" }
    },
    "contrast": {
      "ink.900 on warm.50": "15.5:1",
      "ink.500 on warm.50": "5.7:1",
      "ink.900 on coral.500 (primary button)": "4.8:1",
      "coral.700 on warm.50 (accent text/links)": "5.6:1",
      "warm.50 on ink.900": "15.5:1",
      "rule": "Never set white text on coral.500 (3.3:1). Coral fills carry ink text."
    }
  },
  "type": {
    "direction": "Refined Contemporary",
    "family": { "display": "Gloock (stand-in for Noe Display)", "ui": "Hanken Grotesk (stand-in for Graphik / Neue Haas Grotesk)", "license": "Both OFL via Google Fonts. Replace with licensed Noe Display + Graphik when purchased.", "iosUiFallback": "SF Pro (system) if Hanken Grotesk not bundled" },
    "scale": {
      "displayXL": { "size": "40–74 fluid", "lh": 1.06, "tracking": "-0.012em", "family": "display" },
      "displayL":  { "size": "36–60 fluid",  "lh": 1.06, "tracking": "-0.012em", "family": "display" },
      "h1":        { "size": "32–48 fluid",  "lh": 1.06,  "family": "display" },
      "h2":        { "size": "26–34 fluid",  "lh": 1.08, "family": "display" },
      "h3":        { "size": 24, "lh": 1.15, "family": "display" },
      "lead":      { "size": 19, "lh": 1.55, "weight": 500, "family": "ui" },
      "read":      { "size": 17, "lh": 1.68, "weight": 400, "family": "ui", "maxWidth": "62ch" },
      "body":      { "size": 16, "lh": 1.55, "weight": 400, "family": "ui" },
      "sm":        { "size": 14, "lh": 1.5,  "weight": 600, "family": "ui" },
      "xs":        { "size": 12.5, "lh": 1.4, "weight": 700, "family": "ui" }
    },
    "weights": { "ui": [400, 600, 700, 800], "display": [400] },
    "italic": "None. Upright only across headlines, scripture, UI and brand marks.",
    "headlineColor": "ink.900 only. Coral reserved for CTAs, monogram and deliberate accents."
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96, "32": 128 },
  "layout": { "maxWidth": 1320, "gutter": "20–56 fluid", "readColumn": 640, "breakpoints": { "mobile": 390, "tablet": 768, "desktop": 1440 } },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 22, "xl": 30, "full": 9999, "monogram": "28%" },
  "border": { "hairline": "1px line", "strong": "1px lineStrong", "focusRing": "2px focus, offset 3" },
  "elevation": { "e1": "0 1px 2px rgba(38,31,43,.06)", "e2": "0 18px 40px -18px rgba(38,31,43,.28)", "rule": "Separation via hairlines and color-blocking. e2 only for floating UI (menus, toasts, paywall)." },
  "motion": { "fast": 140, "base": 240, "slow": 420, "ease": "cubic-bezier(.25,.1,.25,1)", "easeOut": "cubic-bezier(.2,.7,.2,1)", "reducedMotion": "Disable all non-essential transitions" },
  "touch": { "minTarget": 44, "chipHeight": 40, "reactHeight": 38, "buttonHeight": 52 },
  "icon": { "library": "Lucide outline", "stroke": 1.75, "sizes": [14, 16, 18, 24] }
}
